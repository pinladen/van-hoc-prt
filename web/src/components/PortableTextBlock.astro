---
const { node } = Astro.props;
const style = node?.style || 'normal';
---

{
  style === 'poem' ? (
    /* Khổ thơ: Đổi hẳn sang text-center để từng câu thơ đều căn giữa tuyệt đối */
    <div class="my-8 text-center select-text">
      <div class="inline-block text-center text-[#2c2724] font-normal leading-[2.2] tracking-wide font-serif whitespace-pre-line">
        <slot />
      </div>
    </div>
  ) : style === 'blockquote' || style === 'epigraph' ? (
    /* Khối Trích dẫn / Lời đề từ */
    <blockquote class="my-6 mx-4 sm:mx-8 pl-5 border-l-2 border-[#8C6D58]/60 text-[#594F47] text-[1.05rem] leading-relaxed italic">
      <slot />
    </blockquote>
  ) : style === 'h3' ? (
    <h3 class="text-xl font-semibold text-[#1a1715] mt-8 mb-4 tracking-tight">
      <slot />
    </h3>
  ) : (
    /* Văn xuôi: Giữ nguyên thụt đầu dòng */
    <p class="indent-8 text-justify text-[#2c2724] leading-loose mb-6 tracking-normal text-[1.075rem]">
      <slot />
    </p>
  )
}