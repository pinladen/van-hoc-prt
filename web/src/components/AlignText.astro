---
const { node } = Astro.props;
const markType = node?._type || Astro.props.markType;
---

{
  markType === 'alignCenter' ? (
    <span class="block text-center !indent-0 my-2">
      <slot />
    </span>
  ) : markType === 'alignRight' ? (
    <span class="block text-right !indent-0 my-2">
      <slot />
    </span>
  ) : markType === 'alignJustify' ? (
    <span class="block text-justify my-1">
      <slot />
    </span>
  ) : (
    <span class="block text-left !indent-0 my-1">
      <slot />
    </span>
  )
}