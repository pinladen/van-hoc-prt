---
import { sanityClient } from '../lib/sanity';
import '../styles/global.css';

// 1. Truy vấn danh mục kèm số lượng tác phẩm trong từng mục
const categoriesQuery = `*[_type == "category" && defined(slug.current)] | order(title asc){
  title,
  "slug": slug.current,
  "count": count(*[_type == "post" && references(^._id)])
}`;

// 2. Truy vấn danh sách bài viết (lấy cả title và slug của category để gắn link)
const postsQuery = `*[_type == "post" && defined(slug.current)] | order(_createdAt desc){
  _id,
  title,
  "slug": slug.current,
  "authorName": author->name,
  "categories": categories[]->{
    title,
    "slug": slug.current
  },
  "mainImage": mainImage.asset->url,
  _createdAt
}`;

const [categories, posts] = await Promise.all([
  sanityClient.fetch(categoriesQuery),
  sanityClient.fetch(postsQuery),
]);
---

<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Văn Học PRT — Góc Tản Văn & Thơ Ca</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">
    <style>
      body { font-family: 'Lora', Georgia, serif; }
      .brand-title { font-family: 'Cinzel', serif; }
    </style>
  </head>

  <body class="bg-[#FAF7F2] text-[#2c2724] min-h-screen selection:bg-[#E9DFCE] antialiased">
    <div class="h-1 bg-[#8C6D58]/40 w-full"></div>

    <div class="max-w-3xl mx-auto px-6 py-16">
      <!-- Header -->
      <header class="text-center mb-12 pb-10 border-b border-[#E3DCCE]">
        <span class="text-xs uppercase tracking-[0.25em] text-[#8C6D58] font-sans font-medium">
          Tạp Chí & Tủ Sách Nhỏ
        </span>
        <h1 class="brand-title text-4xl sm:text-5xl font-bold tracking-wider text-[#1a1715] mt-3 mb-4">
          VĂN HỌC PRT
        </h1>
        <p class="italic text-[#6B5E55] text-base max-w-md mx-auto leading-relaxed">
          "Nơi gom nhặt những thanh âm vụn vặt, những khúc thơ và tản văn của một thời."
        </p>
      </header>

      <!-- Thanh lọc Danh mục / Thể loại -->
      {categories && categories.length > 0 && (
        <nav class="mb-12">
          <div class="flex items-center justify-between mb-3.5">
            <span class="text-[11px] font-sans uppercase tracking-[0.2em] text-[#8C6D58]">
              Duyệt theo chuyên mục
            </span>
            <span class="text-xs font-serif text-[#8C6D58]/80 italic">
              {posts.length} tác phẩm
            </span>
          </div>

          <div class="flex flex-wrap gap-2">
            <!-- Nút Tất cả (Đang kích hoạt) -->
            <a 
              href="/" 
              class="text-xs font-sans px-3.5 py-1.5 rounded-lg bg-[#8C6D58] text-[#FAF7F2] font-medium shadow-sm transition inline-flex items-center gap-1.5"
            >
              <span>Tất cả</span>
              <span class="text-[10px] bg-black/15 px-1.5 py-0.2 rounded-full">
                {posts.length}
              </span>
            </a>

            <!-- Từng danh mục lấy từ Sanity -->
            {categories.map((cat: any) => (
              <a 
                href={`/categories/${cat.slug}`}
                class="text-xs font-sans px-3.5 py-1.5 rounded-lg bg-white/70 text-[#594F47] border border-[#E8E1D3] hover:border-[#8C6D58] hover:text-[#1a1715] hover:bg-[#F2EDE4] transition inline-flex items-center gap-1.5 group"
              >
                <span>{cat.title}</span>
                <span class="text-[10px] text-[#8C6D58] group-hover:text-[#1a1715] transition-colors">
                  {cat.count}
                </span>
              </a>
            ))}
          </div>
        </nav>
      )}

      <!-- Danh sách bài viết -->
      <main class="space-y-6">
        {posts.length === 0 ? (
          <div class="text-center py-16 px-4 border border-dashed border-[#DCD3C1] rounded-2xl bg-white/40">
            <p class="text-[#8C6D58] italic text-lg">Chưa có tác phẩm nào được xuất bản.</p>
          </div>
        ) : (
          posts.map((post: any) => (
            <article class="bg-white/85 border border-[#E8E1D3] rounded-2xl p-5 sm:p-6 hover:border-[#8C6D58]/60 hover:shadow-md transition-all duration-300">
              <div class="flex flex-col sm:flex-row gap-6 items-start sm:items-center">
                
                <!-- Khung ảnh Thumbnail dạng đứng bo góc theo bản vẽ -->
                <!-- Khung ảnh Thumbnail đồng bộ (Nếu không có ảnh sẽ hiện Bìa sách tượng trưng) -->
                <a 
                  href={`/posts/${post.slug}`} 
                  class="w-full sm:w-36 h-48 sm:h-36 shrink-0 overflow-hidden rounded-xl border border-[#E8E1D3] bg-[#F5EFE6] block group relative select-none"
                >
                  {post.mainImage ? (
                    <img 
                      src={post.mainImage} 
                      alt={post.title} 
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                      loading="lazy"
                    />
                  ) : (
                    /* Khung bìa thay thế phong cách trang sách cổ */
                    <div class="w-full h-full flex flex-col items-center justify-center p-3 text-center bg-gradient-to-br from-[#FAF6EE] to-[#ECE3D4] border border-dashed border-[#DCD3C1]/80 rounded-xl group-hover:border-[#8C6D58]/50 transition-all duration-300">
                      <!-- Icon Cuốn sách cổ điển -->
                      <div class="w-10 h-10 rounded-full bg-[#8C6D58]/10 flex items-center justify-center text-[#8C6D58] mb-2 group-hover:scale-110 group-hover:bg-[#8C6D58]/15 transition-transform duration-300">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.4">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                        </svg>
                      </div>
                      <span class="text-[10px] font-sans uppercase tracking-[0.2em] text-[#8C6D58] font-medium">
                        Tác Phẩm
                      </span>
                    </div>
                  )}
                </a>

                <!-- Cụm nội dung: Chuyên mục, Tiêu đề, Tác giả & Ngày -->
                <div class="flex-1 flex flex-col justify-between self-stretch py-1">
                  <div>
                    <!-- 1. Categories (Bấm vào dẫn tới trang danh mục tương ứng) -->
                    {post.categories && post.categories.length > 0 && (
                      <div class="flex flex-wrap gap-2 mb-2.5">
                        {post.categories.map((cat: any) => (
                          <a 
                            href={`/categories/${cat.slug}`}
                            class="text-[11px] font-sans uppercase tracking-widest px-2.5 py-0.5 rounded-md bg-[#F2EDE4] text-[#8C6D58] border border-[#E3DCCE] hover:bg-[#8C6D58] hover:text-[#FAF7F2] hover:border-[#8C6D58] transition"
                          >
                            {cat.title}
                          </a>
                        ))}
                      </div>
                    )}

                    <!-- 2. Tiêu đề -->
                    <h2 class="text-xl sm:text-2xl font-semibold text-[#1a1715] leading-snug">
                      <a 
                        href={`/posts/${post.slug}`} 
                        class="hover:text-[#8C6D58] transition-colors"
                      >
                        {post.title}
                      </a>
                    </h2>
                  </div>

                  <!-- 3. Bút danh & Ngày đăng -->
                  <div class="flex items-center gap-2 mt-4 text-xs font-sans text-[#8C6D58] uppercase tracking-wider">
                    <span>Bút danh: <strong class="text-[#1a1715] font-semibold">{post.authorName || 'Khuyết danh'}</strong></span>
                    <span>•</span>
                    <time>{new Date(post._createdAt).toLocaleDateString('vi-VN')}</time>
                  </div>
                </div>

              </div>
            </article>
          ))
        )}
      </main>

      <footer class="mt-20 pt-8 border-t border-[#E3DCCE] text-center text-xs text-[#9E9085] font-sans">
        <p>© 2026 Văn Học PRT • Lưu giữ những trang viết • Thuỳ Dương </p>
      </footer>
    </div>
  </body>
</html>