---
import { sanityClient } from '../lib/sanity';
import { PortableText } from '@portabletext/astro';
import '../styles/global.css';

const query = `*[_type == "post"] | order(_createdAt desc){
  _id,
  title,
  "slug": slug.current,
  "authorName": author->name,
  _createdAt,
  body
}`;

const posts = await sanityClient.fetch(query);
---

<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Góc Văn Học PRT</title>
    <!-- Nhúng font chữ có chân chuyên cho văn học từ Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">
    <style>
      body {
        font-family: 'Lora', Georgia, serif;
      }
      .brand-title {
        font-family: 'Cinzel', serif;
      }
    </style>
  </head>

  <body class="bg-[#FAF7F2] text-[#2c2724] min-h-screen selection:bg-[#E9DFCE] antialiased">
    <!-- Đường viền mỏng trên cùng tạo điểm nhấn -->
    <div class="h-1 bg-[#8C6D58]/40 w-full"></div>

    <div class="max-w-3xl mx-auto px-6 py-16">
      <!-- Header Tạp chí / Tủ sách -->
      <header class="text-center mb-16 pb-10 border-b border-[#E3DCCE]">
        <span class="text-xs uppercase tracking-[0.25em] text-[#8C6D58] font-sans font-medium">
          Tạp Chí & Tủ Sách Nhỏ
        </span>
        <h1 class="brand-title text-4xl sm:text-5xl font-bold tracking-wider text-[#1a1715] mt-3 mb-4">
          VĂN HỌC PRT
        </h1>
        <p class="italic text-[#6B5E55] text-base max-w-md mx-auto leading-relaxed">
          "Nơi gom nhặt những thanh âm vụn vặt, những khúc thơ và tản văn của một thời."
        </p>
      </header>

      <!-- Danh sách tác phẩm -->
      <main class="space-y-14">
        {posts.length === 0 ? (
          <div class="text-center py-16 px-4 border border-dashed border-[#DCD3C1] rounded-2xl bg-white/40">
            <p class="text-[#8C6D58] italic text-lg">Chưa có tác phẩm nào được xuất bản.</p>
            <p class="text-xs text-[#A09388] mt-2 font-sans tracking-wide">
              Hãy thêm bài mới tại <span class="underline">localhost:3333</span>
            </p>
          </div>
        ) : (
          posts.map((post: any) => (
            <article class="bg-white/80 backdrop-blur-sm border border-[#E8E1D3] rounded-xl p-8 sm:p-10 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.03)] hover:border-[#8C6D58]/40 hover:shadow-md transition-all duration-300">
              
              <!-- Tiêu đề tác phẩm -->
              <h2 class="text-2xl sm:text-3xl font-semibold text-[#1a1715] leading-snug tracking-tight hover:text-[#8C6D58] transition-colors">
                {post.title}
              </h2>

              <!-- Thông tin tác giả & ngày tháng -->
              <div class="flex items-center gap-2 mt-3 mb-6 pb-4 border-b border-[#F0EAE1] text-xs font-sans text-[#8C6D58] uppercase tracking-wider">
                <span>Bút danh: <strong class="text-[#1a1715] font-semibold">{post.authorName || 'Khuyết danh'}</strong></span>
                <span>•</span>
                <time>{new Date(post._createdAt).toLocaleDateString('vi-VN')}</time>
              </div>

              <!-- Nội dung bài thơ / tản văn -->
              <div class="text-[#3F3935] leading-loose text-lg whitespace-pre-line">
                {post.body ? (
                  <PortableText value={post.body} />
                ) : (
                  <p class="italic text-stone-400 text-sm">Chưa có nội dung tác phẩm.</p>
                )}
              </div>
            </article>
          ))
        )}
      </main>

      <!-- Footer chân trang -->
      <footer class="mt-20 pt-8 border-t border-[#E3DCCE] text-center text-xs text-[#9E9085] font-sans">
        <p>© 2026 Văn Học PRT • Lưu giữ những trang viết</p>
      </footer>
    </div>
  </body>
</html>